# املأ هذه القيم في .env فقط. المشروع المستهدف family care داخل peter.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=""
OWNER_EMAIL=
# لا تضع مفاتيح السيرفر في متغيرات VITE_؛ سكربت connect يملأها.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVER_KEY=
OWNER_PASSWORD=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# واتساب عن طريق OpenWA (docs/WHATSAPP.md). المفتاح والجلسة للسيرفر فقط، مش VITE_.
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# للتجربة: أرقام مسموح الإرسال لها فقط، مفصولة بفاصلة. فاضي = كل العملاء الموافقين.
WHATSAPP_ONLY_NUMBERS=
WHATSAPP_DAILY_CAP=100
WHATSAPP_SEND_HOURS=9-21
WHATSAPP_MIN_GAP_SECONDS=20
WHATSAPP_MAX_GAP_SECONDS=60
WHATSAPP_MAX_AGE_HOURS=48
